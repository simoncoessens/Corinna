# =============================================================================
# Corinna (SNIP-Tool) — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.

# --- LLM Provider ---
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.deepseek.com   # or https://openrouter.ai/api/v1

# --- Web Search ---
TAVILY_API_KEY=tvly-...

# --- Admin Dashboard (HTTP Basic Auth) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- CORS (comma-separated origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Optional ---
# GET_API_KEYS_FROM_CONFIG=false
# DSA_HTML_PATH=backend/knowledge_base/dsa.html
